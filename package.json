{
  "name": "nutri-app",
  "version": "0.1.0",
  "private": true,
  "description": "Tracker nutricional y de composición corporal para Android (Expo + TypeScript). Núcleo verificable sin Expo.",
  "scripts": {
    "typecheck:core": "tsc -p tsconfig.check.json",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "schema:sql": "tsx scripts/export-schema.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "build:web": "node web/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}